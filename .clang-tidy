---
# Заголовки чужих библиотек (Arduino, ESP-IDF в .pio/libdeps) не проверяем: иначе шум
# измеряется десятками тысяч предупреждений. Диагностику в .cpp clang-tidy показывает
# всегда, фильтр касается только заголовков.
HeaderFilterRegex: '(mesh-network-core/(src|include)|tdeck/(src|include|apps)|meshcore-fork/lib/meshcore/(src|include))/.*'
WarningsAsErrors: ''
# Набор намеренно узкий: ядро — это встраиваемый код на C, и правила вроде
# «no malloc», «no c-arrays» или «magic numbers» для него контрпродуктивны.
Checks: >-
  -*,
  bugprone-*,
  -bugprone-fold-init-type,
  -bugprone-macro-parentheses,
  -bugprone-optional-value-conversion,
  -bugprone-reserved-identifier,
  -bugprone-unused-raii,
  -bugprone-use-after-move,
  clang-analyzer-*,
  -clang-analyzer-core.NullDereference,
  -clang-analyzer-deadcode.DeadStores,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-interfaces-global-init,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-missing-std-forward,
  -cppcoreguidelines-no-malloc,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-definitions-in-headers,
  -misc-misplaced-const,
  -misc-new-delete-overloads,
  -misc-no-recursion,
  -misc-throw-by-value-catch-by-reference,
  performance-*,
  -performance-avoid-endl,
  -performance-faster-string-find,
  -performance-for-range-copy,
  -performance-implicit-conversion-in-loop,
  -performance-no-automatic-move,
  -performance-no-int-to-ptr,
  readability-*,
  -readability-avoid-const-params-in-decls,
  -readability-braces-around-statements,
  -readability-const-return-type,
  -readability-container-size-empty,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-qualified-auto,
  -readability-redundant-member-init,
  -readability-simplify-subscript-expr,
  -readability-uniqueptr-delete-release,
  -readability-uppercase-literal-suffix,
  -readability-use-anyofallof,
